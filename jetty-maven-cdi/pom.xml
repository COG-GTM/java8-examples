<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.infomas.examples</groupId>
        <artifactId>parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>jetty-maven-cdi</artifactId>
    <packaging>war</packaging>

    <name>jetty-maven-cdi</name>

    <dependencies>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.enterprise</groupId>
            <artifactId>cdi-api</artifactId>
            <version>2.0.SP1</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>javax.el</groupId>
                    <artifactId>javax.el-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
            <scope>provided</scope>
        </dependency>
        <!--
        Jetty is a plain servlet container and does not provide CDI, so the Weld
        runtime is bundled into the webapp (WEB-INF/lib). The shaded artifact carries
        Weld plus the javax.* CDI/annotation/inject APIs in a single jar, which keeps
        everything on one classloader and avoids the Jetty 10 classpath conflicts an
        unshaded Weld causes. Its ServletContainerInitializer bootstraps CDI.
        -->
        <dependency>
            <groupId>org.jboss.weld.servlet</groupId>
            <artifactId>weld-servlet-shaded</artifactId>
            <version>3.1.9.Final</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-maven-plugin</artifactId>
                <version>10.0.25</version>
                <configuration>
                    <!--
                    jetty-env.xml is picked up automatically from WEB-INF by its default name.
                    -->
                    <webApp>
                        <overrideDescriptor>${project.basedir}/src/main/webapp/WEB-INF/web-overwrite.xml</overrideDescriptor>
                    </webApp>
                    <contextXml>${project.basedir}/src/main/webapp/WEB-INF/jetty-context.xml</contextXml>
                </configuration>
                <dependencies>
                    <!--
                    jetty-cdi is part of the Jetty container, so it lives on the plugin
                    (server) classpath alongside jetty core. Its CdiServletContainerInitializer
                    installs the CdiDecoratingListener (mode set via the org.eclipse.jetty.cdi
                    init-param in jetty-context.xml) that Weld hooks into for servlet injection.
                    -->
                    <dependency>
                        <groupId>org.eclipse.jetty</groupId>
                        <artifactId>jetty-cdi</artifactId>
                        <version>10.0.25</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
