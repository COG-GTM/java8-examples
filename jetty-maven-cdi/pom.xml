<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.infomas.examples</groupId>
        <artifactId>parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>jetty-maven-cdi</artifactId>
    <packaging>war</packaging>

    <name>jetty-maven-cdi</name>

    <dependencies>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.enterprise</groupId>
            <artifactId>cdi-api</artifactId>
            <version>1.2</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>javax.el</groupId>
                    <artifactId>javax.el-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
        javax.annotation.PostConstruct was part of the java.xml.ws.annotation
        JDK module, removed in Java 11 (JEP 320). Supply via the external
        Common Annotations API.
        -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
            <scope>provided</scope>
        </dependency>
        <!--
        Weld (CDI RI) runtime: bundled in the war so the webapp classloader
        sees javax.enterprise + the CDI implementation directly. On Java 8
        this lived only on the Jetty plugin classpath, but Jetty 9.4's
        stricter classloader isolation requires it in WEB-INF/lib.
        The shaded jar includes cdi-api and javax.inject.
        -->
        <dependency>
            <groupId>org.jboss.weld.servlet</groupId>
            <artifactId>weld-servlet</artifactId>
            <version>2.4.8.Final</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <!-- version managed by the parent pom (3.4.0) -->
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-maven-plugin</artifactId>
                <!-- Last Jetty 9.x line: javax.servlet API, supports Java 11. -->
                <version>9.4.57.v20241219</version>
                <configuration>
                    <!--
                    Bootstrap Jetty's JNDI provider explicitly. On Java 11
                    with Jetty 9.4 the webapp classloader does not read the
                    plugin's jndi.properties during EnvConfiguration.
                    -->
                    <systemProperties>
                        <systemProperty>
                            <name>java.naming.factory.initial</name>
                            <value>org.eclipse.jetty.jndi.InitialContextFactory</value>
                        </systemProperty>
                        <systemProperty>
                            <name>java.naming.factory.url.pkgs</name>
                            <value>org.eclipse.jetty.jndi</value>
                        </systemProperty>
                    </systemProperties>
                    <webApp>
                        <overrideDescriptor>src/main/webapp/WEB-INF/web-overwrite.xml</overrideDescriptor>
                    </webApp>
                    <contextXml>src/main/webapp/WEB-INF/jetty-context.xml</contextXml>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
