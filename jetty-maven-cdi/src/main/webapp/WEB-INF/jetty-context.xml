<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "http://www.eclipse.org/jetty/configure_9_3.dtd">
<Configure class="org.eclipse.jetty.webapp.WebAppContext">
    <!-- Jetty 9.4.20+ CDI integration (jetty-cdi): Weld in WEB-INF/lib registers its decorator -->
    <Call name="setInitParameter">
        <Arg>org.eclipse.jetty.cdi</Arg>
        <Arg>CdiDecoratingListener</Arg>
    </Call>
    <!-- jetty:run serves classes from target/classes; use one flat bean archive so Weld's
         ManagerObjectFactory (jetty-env.xml JNDI binding) can resolve the BeanManager -->
    <Call name="setInitParameter">
        <Arg>org.jboss.weld.environment.servlet.archive.isolation</Arg>
        <Arg>false</Arg>
    </Call>
    <!-- Expose the container-side jetty-cdi initializer (a plugin dependency) to the webapp -->
    <Get name="serverClasspathPattern">
        <Call name="exclude">
            <Arg>
                <Array type="java.lang.String">
                    <Item>org.eclipse.jetty.cdi.</Item>
                </Array>
            </Arg>
        </Call>
    </Get>
</Configure>
