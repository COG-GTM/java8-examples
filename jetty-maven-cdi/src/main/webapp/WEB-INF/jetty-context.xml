<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_9_3.dtd">
<Configure class="org.eclipse.jetty.webapp.WebAppContext">
    <!-- Weld and the CDI API live on the jetty-maven-plugin classpath; expose them to the webapp -->
    <Get name="serverClasspathPattern">
        <Call name="exclude">
            <Arg>
                <Array type="java.lang.String">
                    <Item>javax.enterprise.</Item>
                    <Item>javax.decorator.</Item>
                    <Item>org.eclipse.jetty.servlet.ServletContextHandler.Decorator</Item>
                </Array>
            </Arg>
        </Call>
    </Get>
    <Call name="setAttribute">
        <Arg>org.eclipse.jetty.server.webapp.ContainerIncludeJarPattern</Arg>
        <Arg>.*/weld-servlet-[^/]*\.jar$</Arg>
    </Call>
</Configure>
