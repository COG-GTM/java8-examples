<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://www.eclipse.org/jetty/configure_9_3.dtd">
<Configure id="wac" class="org.eclipse.jetty.webapp.WebAppContext">
    <!-- The CDI API and implementation are deployed with the web application,
         so javax.enterprise must not be treated as a (parent-only) system class. -->
    <Get name="systemClasspathPattern">
        <Call name="add">
            <Arg>-javax.enterprise.</Arg>
        </Call>
    </Get>

    <!-- Jetty 9.4 CDI integration ('cdi-decorate' style): Jetty listens for the
         decorator that Weld registers as a context attribute, so Weld does not
         need access to any Jetty class. -->
    <Call name="addEventListener">
        <Arg>
            <New class="org.eclipse.jetty.webapp.DecoratingListener">
                <Arg><Ref refid="wac" /></Arg>
                <Arg>org.eclipse.jetty.cdi.decorator</Arg>
            </New>
        </Arg>
    </Call>
    <Call name="setAttribute">
        <Arg>org.eclipse.jetty.cdi</Arg>
        <Arg>CdiDecoratingListener</Arg>
    </Call>
</Configure>
