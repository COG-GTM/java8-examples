<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_10_0.dtd">

<!--
  Jetty 12 (EE10) CDI integration.

  Enables Jetty's jetty-ee10-cdi integration in "CdiSpiDecorator" mode. In this
  mode Jetty uses the CDI SPI (the Weld BeanManager) to decorate and inject
  Servlets, Filters and Listeners. This replaces the Jetty 9 "serverClasses"
  Decorator hack and the manual JNDI BeanManager binding from jetty-env.xml.
-->
<Configure class="org.eclipse.jetty.ee10.webapp.WebAppContext">
    <Call name="setAttribute">
        <Arg>org.eclipse.jetty.cdi</Arg>
        <Arg>CdiSpiDecorator</Arg>
    </Call>
</Configure>
