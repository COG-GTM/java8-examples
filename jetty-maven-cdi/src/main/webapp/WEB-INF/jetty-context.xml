<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://www.eclipse.org/jetty/configure_10_0.dtd">
<Configure class="org.eclipse.jetty.webapp.WebAppContext">
    <!--
    Jetty 10 ships its own CDI integration (jetty-cdi). 'CdiSpiDecorator' lets Jetty decorate
    (inject into) servlets, filters and listeners through the standard CDI SPI (BeanManager),
    so no Weld specific container integration is needed.
    -->
    <Call name="setAttribute">
        <Arg>org.eclipse.jetty.cdi</Arg>
        <Arg>CdiSpiDecorator</Arg>
    </Call>
    <!-- jetty-cdi lives on the container classpath, so it must be scanned for its
         ServletContainerInitializer. This attribute is single valued and overwrites the
         default of jetty-maven-plugin, so the default patterns are repeated here. -->
    <Call name="setAttribute">
        <Arg>org.eclipse.jetty.server.webapp.ContainerIncludeJarPattern</Arg>
        <Arg>.*/javax.servlet-[^/]*\.jar$|.*/jetty-servlet-api-[^/]*\.jar$|.*javax.servlet.jsp.jstl-[^/]*\.jar|.*taglibs-standard-impl-.*\.jar|.*/jetty-cdi-[^/]*\.jar$</Arg>
    </Call>
</Configure>
