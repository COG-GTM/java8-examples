<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-" "http://www.eclipse.org/jetty/configure_10_0.dtd">
<Configure class="org.eclipse.jetty.webapp.WebAppContext">
    <!--
    Jetty 10 CDI integration: jetty-cdi's CdiServletContainerInitializer reads this
    init-param and installs the CdiDecoratingListener, which Weld hooks into to inject
    CDI beans into servlets/filters/listeners.

    Run with `mvn jetty:run-war`, not `jetty:run`: the BeanManager JNDI binding in
    jetty-env.xml only resolves for a bean archive whose id contains WEB-INF/classes.
    Under `jetty:run` (classes served from target/classes) the app still serves requests
    but the java:comp/env/BeanManager lookup logs WELD-001300. See README.
    -->
    <Call name="setInitParameter">
        <Arg>org.eclipse.jetty.cdi</Arg>
        <Arg>CdiDecoratingListener</Arg>
    </Call>
</Configure>
